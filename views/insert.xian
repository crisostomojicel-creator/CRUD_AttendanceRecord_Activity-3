
{{> head}}

<body class="bg-gray-100">
  <div class="container mx-auto px-4 py-8">

    <!-- Main Title -->
    <h1 class="text-3xl font-bold text-center mb-2">
      Attendance Record System
    </h1>

    <p class="text-center text-gray-600 mb-8">
      Manage employee attendance records
    </p>

    <!-- Add Attendance -->
    <h2 class="text-xl font-bold text-center mb-4">
      Add Attendance Record
    </h2>

    <form method="POST" action="/attendanceRecords">
      <table class="border-collapse border border-gray-300 bg-white mb-8 mx-auto w-full max-w-4xl text-sm">

        <tr>
          <td class="border border-gray-300 p-2 font-medium">
            Employee Name
          </td>
          <td class="border border-gray-300 p-2">
            <input
              class="border border-gray-300 rounded p-2 w-full"
              type="text"
              name="EmployeeName"
              placeholder="Employee name"
              required>
          </td>

          <td class="border border-gray-300 p-2 font-medium">
            Date
          </td>
          <td class="border border-gray-300 p-2">
            <input
              class="border border-gray-300 rounded p-2 w-full"
              type="date"
              name="date"
              required>
          </td>
        </tr>

        <tr>
          <td class="border border-gray-300 p-2 font-medium">
            Time In
          </td>
          <td class="border border-gray-300 p-2">
            <input
              class="border border-gray-300 rounded p-2 w-full"
              type="time"
              name="timeIn"
              required>
          </td>

          <td class="border border-gray-300 p-2 font-medium">
            Time Out
          </td>
          <td class="border border-gray-300 p-2">
            <input
              class="border border-gray-300 rounded p-2 w-full"
              type="time"
              name="timeOut"
              required>
          </td>
        </tr>

        <tr>
          <td class="border border-gray-300 p-2 font-medium">
            Status
          </td>
          <td class="border border-gray-300 p-2">
            <select
              class="border border-gray-300 rounded p-2 w-full"
              name="status"
              required>
              <option value="">Select Status</option>
              <option value="Present">Present</option>
              <option value="Late">Late</option>
              <option value="Absent">Absent</option>
            </select>
          </td>

          <td class="border border-gray-300 p-2 text-center" colspan="2">
            <button
              class="border border-gray-400 hover:bg-gray-100 text-black font-semibold px-5 py-2 rounded"
              type="submit">
              + Add Attendance
            </button>
          </td>
        </tr>

      </table>
    </form>

    <!-- Attendance Records Title -->
    <h2 class="text-xl font-bold text-center mb-4">
      Attendance Records
    </h2>

    <!-- Attendance Records Table -->
    <div class="overflow-x-auto">
      <table class="border-collapse border border-gray-300 bg-white w-full text-sm">

        <thead>
          <tr class="bg-gray-100 text-black">
            <th class="border border-gray-300 p-3">ID</th>
            <th class="border border-gray-300 p-3">Employee Name</th>
            <th class="border border-gray-300 p-3">Date</th>
            <th class="border border-gray-300 p-3">Time In</th>
            <th class="border border-gray-300 p-3">Time Out</th>
            <th class="border border-gray-300 p-3">Status</th>
            <th class="border border-gray-300 p-3">Actions</th>
          </tr>
        </thead>

        <tbody>
          {{#each attendanceRecords}}
          <tr class="hover:bg-gray-50">

            <td class="border border-gray-300 p-3">
              {{this.id}}
            </td>

            <td class="border border-gray-300 p-3">
              {{this.EmployeeName}}
            </td>

            <td class="border border-gray-300 p-3">
              {{this.date}}
            </td>

            <td class="border border-gray-300 p-3">
              {{this.timeIn}}
            </td>

            <td class="border border-gray-300 p-3">
              {{this.timeOut}}
            </td>

            <td class="border border-gray-300 p-3">
              {{this.status}}
            </td>

            <td class="border border-gray-300 p-3 whitespace-nowrap">
              <a
                class="inline-block border border-gray-400 hover:bg-gray-100 text-black px-3 py-1 rounded"
                href="/attendanceRecords/{{this.id}}">
                Edit
              </a>

              <form
                method="POST"
                action="/attendanceRecords/{{this.id}}/delete"
                onsubmit="return confirm('Are you sure you want to delete this attendance record?')"
                class="inline-block">

                <button
                  class="border border-gray-400 hover:bg-gray-100 text-black px-3 py-1 rounded"
                  type="submit">
                  Delete
                </button>
              </form>
            </td>

          </tr>

          {{else}}
          <tr>
            <td
              class="border border-gray-300 p-4 text-center text-gray-500"
              colspan="7">
              No attendance records found.
            </td>
          </tr>
          {{/each}}
        </tbody>

      </table>
    </div>

  </div>
</body>

{{> footer}}
